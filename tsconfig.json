{
  "extends": "@total-typescript/tsconfig/bundler",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ESNext", "DOM"],
    "types": ["bun"],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "paths": {
      // Electrobun 2.x projects its SDK into .hutch/devkit (generated by
      // `electrobun sync`), not node_modules — see docs/adr/0001.
      "electrobun": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/main": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "@common/*": ["./src/client/common/*"],
      "@components/*": ["./src/client/components/*"],
      "@client/*": ["./src/client/*"],
      "@server/*": ["./src/server/*"],
      "@native/*": ["./resources/native/*"]
    }
  },
  "exclude": ["node_modules"]
}
